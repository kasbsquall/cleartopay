# Copy to .env on the Vultr VM and fill in. Never commit .env.
# Vultr Serverless Inference key (Products > Serverless > Inference)
VULTR_INFERENCE_API_KEY=
# Vultr account API key (Account > API). Only the backend uses it; it never enters a sandbox.
VULTR_API_KEY=
INFERENCE_BASE_URL=https://api.vultrinference.com/v1
PLANNER_MODEL=glm-5.3
VERIFIER_MODEL=qwen3.8-27b
